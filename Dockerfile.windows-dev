FROM php:8.3.36-apache

# Set timezone
ENV TZ=Europe/Berlin

# Remove annoying messages during package installation
ARG DEBIAN_FRONTEND=noninteractive

# Install dependencies and PHP extension build requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
  tzdata \
  ca-certificates \
  git \
  git-lfs \
  libcurl4-openssl-dev \
  libfreetype6-dev \
  libjpeg62-turbo-dev \
  libpng-dev \
  libicu-dev \
  libonig-dev \
  libxml2-dev \
  libzip-dev \
  zlib1g-dev && \
  apt-get clean && rm -rf /var/lib/apt/lists/*

# Install required PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
  docker-php-ext-install curl dom gd intl mbstring xml zip

# Initialize Git LFS
RUN git lfs install

# Copy virtual host configuration
COPY default.dev.conf /etc/apache2/sites-available/000-default.conf

# Remove default content (existing index.html)
RUN rm -f /var/www/html/index.html

# Activate Apache modules
RUN a2enmod ssl headers rewrite

# Tell container to listen to port 80 at runtime
EXPOSE 80

# Start Apache web server
CMD ["apache2-foreground"]
